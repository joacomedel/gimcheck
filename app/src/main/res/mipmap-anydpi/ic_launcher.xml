<?xml version="1.0" encoding="utf-8"?>
<!--
  Respaldo NO adaptativo de `@mipmap/ic_launcher`: un vector plano con el fondo
  `bg` y la mancuerna en `accent`, para que el recurso exista en toda
  configuración (herramientas, previews, launchers que piden el drawable sin
  soporte de adaptive-icon).
  En el teléfono no se usa: minSdk = 26, así que siempre gana
  `mipmap-anydpi-v26/ic_launcher.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/gim_bg"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="@color/gim_accent"
        android:pathData="M40,50h28v8h-28z M30,36h10v36h-10z M68,36h10v36h-10z M24,44h6v20h-6z M78,44h6v20h-6z" />
</vector>
