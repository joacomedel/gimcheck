    <string name="rest_permiso_titulo">Avisar el fin del descanso</string>
    <string name="rest_permiso_texto">Para mostrarte cuánto falta y avisarte cuando termina el descanso con la app cerrada, GimCheck necesita permiso de notificaciones. Si lo negás, el cronómetro sigue funcionando pero no vas a ver el aviso.</string>
    <string name="rest_permiso_alarmas_texto">Para que el aviso llegue aunque el teléfono mate el proceso, GimCheck usa alarmas exactas. Sin ese permiso el cronómetro igual funciona mientras el servicio siga vivo.</string>
    <string name="rest_permiso_activar">Permitir</string>
    <string name="rest_permiso_ahora_no">Ahora no</string>

